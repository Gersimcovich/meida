# Demo works without credentials. Keep real .env files out of Git.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/meida.sqlite

# For Schwab, first set up local HTTPS and use its EXACT registered callback.
# APP_ORIGIN=https://127.0.0.1:3000
# SCHWAB_REDIRECT_URI=https://127.0.0.1:3000/api/auth/schwab/callback
# TLS_KEY_FILE=/absolute/private/path/localhost-key.pem
# TLS_CERT_FILE=/absolute/private/path/localhost-cert.pem

SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key stable: it encrypts saved brokerage tokens.
TOKEN_ENCRYPTION_KEY=

# Private Railway hosting (single owner). Use a persistent volume mounted at /data.
# HOST=0.0.0.0
# NODE_ENV=production
# APP_ORIGIN=https://your-service.up.railway.app
# SCHWAB_REDIRECT_URI=https://your-service.up.railway.app/api/auth/schwab/callback
# DATABASE_PATH=/data/meida.sqlite
# OWNER_PASSWORD=generate_a_long_random_password_and_keep_it_private
# Railway terminates HTTPS; leave TLS_KEY_FILE and TLS_CERT_FILE unset when hosted.
